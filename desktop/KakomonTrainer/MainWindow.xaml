<Window x:Class="KakomonTrainer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="過去問トレーナー" Icon="pack://application:,,,/KakomonTrainer;component/Assets/app.ico" Width="1440" Height="940" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="28,20,28,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1"><TextBlock Text="過去問トレーナー" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="用紙の準備から、採点・復習まで" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/></StackPanel>
    </Grid>
    <Border DockPanel.Dock="Bottom" Padding="28,8,24,12"><DockPanel><Button x:Name="CancelButton" Content="処理を中止" Click="Cancel_Click" DockPanel.Dock="Right" Visibility="Collapsed"/><ProgressBar x:Name="BusyBar" Width="110" Height="4" IsIndeterminate="True" Visibility="Collapsed" DockPanel.Dock="Right" Margin="12"/><TextBlock x:Name="StatusText" Text="準備完了" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" FontSize="12" MaxHeight="60" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
    <TabControl x:Name="Tabs" Margin="12,0,20,4" Style="{StaticResource Navigation}" SelectionChanged="Tabs_SelectionChanged">
      <TabItem Header="用紙・答案" Tag="&#xE80F;">
        <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12"><TextBlock Text="登録した解答用紙" Style="{StaticResource SectionHeading}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="用紙と解説を登録" Style="{StaticResource PrimaryButton}" Click="Register_Click"/><Button Content="用紙を編集" Click="Edit_Click"/><Button Content="印刷用PDF" Click="Blank_Click"/><Button Content="用紙を削除" Click="DeleteTemplate_Click"/></StackPanel></DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Surface}"><Grid><DataGrid x:Name="TemplateGrid" Margin="4" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="Edit_Click"><DataGrid.Columns><DataGridTextColumn Header="用紙名" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="ページ" Binding="{Binding PageCount}" Width="80"/><DataGridTextColumn Header="設問" Binding="{Binding QuestionCount}" Width="80"/><DataGridTextColumn Header="配点合計" Binding="{Binding TotalMaxScore}" Width="100"/><DataGridTextColumn Header="登録日時" Binding="{Binding CreatedAt, StringFormat=yyyy/MM/dd HH:mm}" Width="180"/></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,40,24,0" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=TemplateGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="解答用紙を登録して始めましょう" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="PDFと解説資料をまとめて登録できます。" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Grid></Border>
          <DockPanel Grid.Row="2" Margin="0,24,0,12"><TextBlock Text="答案と採点履歴" Style="{StaticResource SectionHeading}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox x:Name="OcrCheck" Content="取り込み時にOCR" IsChecked="True" VerticalAlignment="Center" Margin="10"/><Button Content="答案を取り込む" Style="{StaticResource PrimaryButton}" Click="Scan_Click"/><Button Content="転記・結果を開く" Click="OpenSession_Click"/><Button Content="更新" Click="Refresh_Click"/></StackPanel></DockPanel>
          <Border Grid.Row="3" Style="{StaticResource Surface}"><Grid><DataGrid x:Name="SessionGrid" Margin="4" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="OpenSession_Click"><DataGrid.Columns><DataGridTextColumn Header="取り込み日時" Binding="{Binding CreatedAt, StringFormat=yyyy/MM/dd HH:mm}" Width="180"/><DataGridTextColumn Header="答案ID" Binding="{Binding SessionId}" Width="*"/><DataGridTextColumn Header="用紙ID" Binding="{Binding TemplateId}" Width="*"/><DataGridTextColumn Header="状態" Binding="{Binding StatusLabel}" Width="100"/><DataGridTextColumn Header="エラー" Binding="{Binding Error}" Width="2*"/></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,40,24,0" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=SessionGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="取り込んだ答案がここに表示されます" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="用紙を選んで、記入済みの答案を取り込んでください。" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="用紙・領域の編集" Tag="&#xE70F;">
        <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
          <DockPanel Margin="0,0,16,0"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="前ページ" Click="PreviousPage_Click"/><TextBlock x:Name="PageLabel" Text="用紙を選んで「用紙を編集」を押してください" VerticalAlignment="Center" Margin="12,0"/><Button Content="次ページ" Click="NextPage_Click"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="設問を選び、画像をドラッグして解答領域を追加します。複数領域は追加順で読み取ります。" TextWrapping="Wrap" Margin="4,12"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid HorizontalAlignment="Left" VerticalAlignment="Top"><Image x:Name="SheetImage" Stretch="Fill"/><Canvas x:Name="RegionCanvas" Background="Transparent" MouseLeftButtonDown="Region_Down" MouseMove="Region_Move" MouseLeftButtonUp="Region_Up"/></Grid></ScrollViewer></DockPanel>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="用紙名"/><TextBox x:Name="TitleBox"/>
            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="大学"/><TextBox x:Name="UniversityBox"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="年度（西暦）"/><TextBox x:Name="YearBox"/></StackPanel></Grid>
            <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0"><TextBlock Text="文理"/><ComboBox x:Name="TrackBox" SelectedValuePath="Content"><ComboBoxItem Content="指定なし"/><ComboBoxItem Content="文系"/><ComboBoxItem Content="理系"/><ComboBoxItem Content="共通"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="科目"/><TextBox x:Name="SubjectBox"/></StackPanel></Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="問題用紙PDFを添付" Click="AttachProblemSheets_Click"/><Button Content="配点・構成を自動設定" Click="AutoScore_Click"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Button Content="設問を追加" Click="AddQuestion_Click"/><Button Content="設問を削除" Click="DeleteQuestion_Click"/><Button Content="保存" Style="{StaticResource PrimaryButton}" Click="SaveTemplate_Click"/></StackPanel>
            <ListBox x:Name="QuestionList" Height="110" DisplayMemberPath="Id" SelectionChanged="Question_Changed" Margin="0,8"/>
            <StackPanel x:Name="QuestionForm">
              <TextBlock Text="設問ID"/><TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="配点"/><TextBox Text="{Binding MaxScore, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="分類（集計用）"/><TextBox Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
              <TextBlock Text="採点形式"/><ComboBox x:Name="FormatBox" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding AnswerFormat}" SelectionChanged="Format_Changed"/>
              <TextBlock Text="解答言語"/><ComboBox x:Name="LanguageBox" SelectedValuePath="Content" SelectedValue="{Binding Language}"><ComboBoxItem Content="ja"/><ComboBoxItem Content="en"/></ComboBox>
              <TextBlock Text="正答（複数候補は改行・｜区切り）"/><TextBox Text="{Binding AnswerKey, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="62" TextWrapping="Wrap"/>
              <TextBlock Text="数値の許容誤差"/><TextBox Text="{Binding AnswerTolerance, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
              <TextBlock Text="採点時の指示"/><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="65" TextWrapping="Wrap"/>
              <TextBlock Text="参照資料（1行1パス）"/><TextBox Text="{Binding ReferencesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="65"/><Button Content="参照資料を追加" Click="AddReference_Click"/>
              <TextBlock Text="解答領域" Margin="0,10,0,4"/><ListBox x:Name="RegionList" ItemsSource="{Binding Regions}" Height="85"/><Button Content="選択した領域を削除" Click="DeleteRegion_Click"/>
            </StackPanel>
          </StackPanel></ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="転記の確認" Tag="&#xE8A5;">
        <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12"><TextBlock x:Name="ReviewTitle" Text="答案を開いてください" FontSize="22"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="転記を保存" Click="SaveTranscriptions_Click"/><Button Content="保存して採点" Style="{StaticResource PrimaryButton}" Click="Grade_Click"/></StackPanel></DockPanel>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="TranscriptionList" DisplayMemberPath="QuestionId" SelectionChanged="Transcription_Changed" Margin="0,0,16,0"/>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0"><StackPanel x:Name="CropImages"/></ScrollViewer>
            <DockPanel Grid.Column="2" x:Name="TranscriptionForm"><TextBlock DockPanel.Dock="Top" Text="画像を確認して、読み取り間違いを修正してください。" TextWrapping="Wrap" Margin="0,0,0,12"/><CheckBox DockPanel.Dock="Top" Content="この設問は未記入（0点で採点）" IsChecked="{Binding IsBlank}" Margin="0,0,0,12"/><TextBox Text="{Binding TranscriptionText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="17"/></DockPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="採点結果・復習" Tag="&#xE9D9;">
        <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel><TextBlock x:Name="ResultTitle" Text="採点結果" FontSize="25" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="点数の修正を保存" Click="SaveScores_Click"/><Button Content="赤入れPDF" Click="GradedPdf_Click"/><Button Content="PDFを書き出す" Click="ExportPdf_Click"/><Button Content="復習ログを書き出す" Click="ExportLog_Click"/></StackPanel></DockPanel>
          <DataGrid x:Name="ResultGrid" Grid.Row="1" Margin="0,16" RowHeight="NaN" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="設問" Binding="{Binding Id}" IsReadOnly="True" Width="80"/><DataGridTextColumn Header="得点（修正可）" Binding="{Binding Score, ValidatesOnExceptions=True}" Width="120"/><DataGridTextColumn Header="配点" Binding="{Binding MaxScore}" IsReadOnly="True" Width="65"/><DataGridTextColumn Header="確信度" Binding="{Binding Confidence}" IsReadOnly="True" Width="80"/><DataGridTextColumn Header="講評" Binding="{Binding Feedback}" IsReadOnly="True" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="8"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ResultDetails" TextWrapping="Wrap" FontSize="15"/></ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="学習の集計" Tag="&#xE9D2;"><DockPanel Margin="24"><Button DockPanel.Dock="Top" Content="集計を更新" Click="Stats_Click" HorizontalAlignment="Left"/><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="StatsText" FontSize="19" TextWrapping="Wrap" Margin="0,20"/></ScrollViewer></DockPanel></TabItem>
      <TabItem Header="設定" Tag="&#xE713;"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsPanel" Margin="28" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="保存先・OCR・採点サービス" FontSize="24" Margin="0,0,0,18"/><TextBlock Text="認証情報は、このWindowsユーザーだけが復号できる形式で保存します。変更した設定は保存後に反映されます。" TextWrapping="Wrap" Margin="0,0,0,16"/><StackPanel x:Name="SettingFields"/><Button Content="設定を保存" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click" HorizontalAlignment="Left"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
  </DockPanel>
</Window>
