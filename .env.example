# ============================================================
# 模試自動採点システム 設定ファイルのサンプル
# このファイルを .env にコピーして値を埋めてください。
# .env と secrets/ は .gitignore 済みです。
# ============================================================

# ---------- OCR ----------
# google_vision | azure_di | claude_vision
# 既定は google_vision。単語バウンディングボックスが取れるため赤入れ精度が高い。
# claude_vision は退避手段で、単語座標を返さないため
# 赤入れは「設問単位の赤枠＋欄外コメント」にフォールバックする。
OCR_BACKEND=google_vision

# サービスアカウント JSON のパス（プロジェクトルートからの相対パスで可）
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-vision-credentials.json

# OCR_BACKEND=azure_di のときのみ使用（pip install -r requirements-optional.txt が必要）
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# ---------- LLM 採点 ----------
# anthropic | openai | kimi | openai_compatible
GRADING_PROVIDER=anthropic

# プロバイダ別のモデル名が未設定のときだけ使われる共通フォールバック。
# 基本はプロバイダ別の変数（下の *_MODEL）を設定すること。
# プロバイダだけ切り替えて古いモデル名が残ると、不可解な 400 エラーになるため。
GRADING_MODEL=
GRADING_MAX_TOKENS=8192

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
# 例: gpt-5.1 など。実際に使えるモデル ID は公式ドキュメントで確認して設定すること。
OPENAI_MODEL=
OPENAI_BASE_URL=

KIMI_API_KEY=
# 例: kimi-k2-thinking など。公式ドキュメントで確認して設定すること。
KIMI_MODEL=
KIMI_BASE_URL=https://api.moonshot.ai/v1

# GRADING_PROVIDER=openai_compatible のとき（任意の OpenAI 互換ベンダー）
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ---------- 採点の安定化 ----------
# true にすると同一設問を 2 回採点し、点差が閾値以上なら警告を出す（採用するのは 1 回目）
# 採点の system と参照資料をプロンプトキャッシュに載せる（Anthropic のみ）。
# 同じ設問を生徒の人数だけ採点するため、既定の true を推奨。
GRADING_PROMPT_CACHE=true

DOUBLE_GRADING=false
DOUBLE_GRADING_THRESHOLD=3

# ---------- 答えのみ設問の採点 ----------
# 答えのみ設問は決定的な照合（数値の許容誤差・文字列正規化）で採点する。
# 文字列で白黒つかないケースだけ下記モデルにフォールバックする（ANTHROPIC_API_KEY を流用）。
# false にすると曖昧ケースは confidence=low ＋ 警告で人手確認に回す（API を一切呼ばない）。
ANSWER_ONLY_LLM_FALLBACK=true
ANSWER_ONLY_MODEL=claude-haiku-4-5
# 数値解答の既定の絶対許容誤差（設問側で個別指定がある場合はそちらが優先）
ANSWER_ONLY_NUMERIC_TOLERANCE=0.0

# ---------- スキャン ----------
SCAN_DPI=300
CROP_MARGIN_PX=8

# ---------- サーバー ----------
HOST=127.0.0.1
PORT=8765

# ---------- Updates ----------
# GitHub Releases を更新元として使う場合のみ owner/repository を指定
UPDATE_REPOSITORY=eugene-rb/kakomon-trainer
